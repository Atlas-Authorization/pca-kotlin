<?xml version="1.0" encoding="UTF-8"?>
<!-- Native tools for the JVM: the LESS library (libatlas_less) and the reference WebAssembly host (pca-wasmtime-host) as jar resources under
     natives/<os>-<arch>/, staged by the release workflow: mvn package -Dpca.natives=/path/to/stage. A plain source build carries none. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.atlasauth</groupId><artifactId>pca-natives-kotlin</artifactId><version>0</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kotlin.version>2.0.21</kotlin.version>
    <pca.natives>${project.build.directory}/natives-in</pca.natives>
  </properties>
  <dependencies>
    <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>${kotlin.version}</version></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources><resource><directory>${pca.natives}</directory></resource></resources>
    <sourceDirectory>src/main/kotlin</sourceDirectory>
    <testSourceDirectory>src/test/kotlin</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-maven-plugin</artifactId><version>${kotlin.version}</version>
        <configuration><jvmTarget>17</jvmTarget></configuration>
        <executions>
          <execution><id>compile</id><phase>compile</phase><goals><goal>compile</goal></goals></execution>
          <execution><id>test-compile</id><phase>test-compile</phase><goals><goal>test-compile</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
