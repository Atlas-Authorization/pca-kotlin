<?xml version="1.0" encoding="UTF-8"?>
<!-- Mutation-testing build only (PIT over the compiled native verifier). The module itself builds with Gradle (Android); this
     pom compiles every shipped source (verifier, stepup, guard-common, pca-ktor, pca-spring) + the mutation harness and has no effect on the Gradle build. src/mutation/android-stubs stands in for the Android classes, for the store's own logic only. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.atlasauth</groupId><artifactId>pca-kotlin-mutation</artifactId><version>0</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kotlin.version>2.0.21</kotlin.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId><version>3.3.4</version><type>pom</type><scope>import</scope></dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <!-- stepup, pca-ktor, pca-spring: the versions of gradle/libs.versions.toml; the -jvm artifacts because Maven does not read Gradle module metadata -->
    <dependency><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core-jvm</artifactId><version>1.8.1</version></dependency>
    <dependency><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-serialization-json-jvm</artifactId><version>1.6.3</version></dependency>
    <dependency><groupId>com.squareup.okhttp3</groupId><artifactId>okhttp</artifactId><version>4.12.0</version></dependency>
    <dependency><groupId>io.ktor</groupId><artifactId>ktor-server-core-jvm</artifactId><version>2.3.12</version></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId></dependency>
    <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><version>6.0.0</version><scope>provided</scope></dependency>
    <dependency><groupId>com.squareup.okhttp3</groupId><artifactId>mockwebserver</artifactId><version>4.12.0</version><scope>test</scope></dependency>
    <dependency><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-test-jvm</artifactId><version>1.8.1</version><scope>test</scope></dependency>
    <dependency><groupId>io.ktor</groupId><artifactId>ktor-server-test-host-jvm</artifactId><version>2.3.12</version><scope>test</scope></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>${kotlin.version}</version></dependency>
    <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>1.80</version></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
    <!-- authorize (0.5): the JDBC replay store is tested on SQLite; test scope only, the library has no driver dependency -->
    <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.46.1.3</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <sourceDirectory>src/main/kotlin</sourceDirectory>
    <resources><resource><directory>pca-spring/src/main/resources</directory></resource></resources>
    <testSourceDirectory>src/mutation/kotlin</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-maven-plugin</artifactId><version>${kotlin.version}</version>
        <configuration><jvmTarget>17</jvmTarget></configuration>
        <executions>
          <execution><id>compile</id><phase>compile</phase><goals><goal>compile</goal></goals>
            <configuration><sourceDirs>
              <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
              <sourceDir>${project.basedir}/guard-common</sourceDir>
              <sourceDir>${project.basedir}/pca-ktor/src/main/kotlin</sourceDir>
              <sourceDir>${project.basedir}/pca-spring/src/main/kotlin</sourceDir>
              <sourceDir>${project.basedir}/src/mutation/android-stubs</sourceDir>
            </sourceDirs></configuration></execution>
          <execution><id>test-compile</id><phase>test-compile</phase><goals><goal>test-compile</goal></goals>
            <configuration><sourceDirs>
              <sourceDir>${project.basedir}/src/mutation/kotlin</sourceDir>
              <sourceDir>${project.basedir}/src/test/kotlin</sourceDir>
              <sourceDir>${project.basedir}/guard-common-test</sourceDir>
              <sourceDir>${project.basedir}/pca-ktor/src/test/kotlin</sourceDir>
              <sourceDir>${project.basedir}/pca-spring/src/test/kotlin</sourceDir>
            </sourceDirs></configuration></execution>
        </executions>
      </plugin>
      <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version><configuration><argLine>-Xss16m -Xmx2g</argLine></configuration></plugin>
      <plugin><groupId>org.pitest</groupId><artifactId>pitest-maven</artifactId><version>1.17.1</version>
        <configuration>
          <targetClasses><param>net.atlasauth.pca.verifier.*</param><param>net.atlasauth.pca.stepup.*</param><param>net.atlasauth.pca.guard.*</param><param>net.atlasauth.pca.ktor.*</param><param>net.atlasauth.pca.spring.*</param></targetClasses>
          <targetTests><param>net.atlasauth.pca.verifier.*</param><param>net.atlasauth.pca.stepup.*</param><param>net.atlasauth.pca.guard.*</param><param>net.atlasauth.pca.ktor.*</param><param>net.atlasauth.pca.spring.*</param></targetTests>
          <mutators><mutator>ALL</mutator></mutators>
          <avoidCallsTo><avoidCallsTo>kotlin.jvm.internal.Intrinsics</avoidCallsTo></avoidCallsTo>
          <!-- equivalents covered by the seconds-long differential oracles timed out at 1.25x+8s under 4 threads (run 41911466407: ProvenanceGate/ParamProvenance/ActionSchema), flipping ledger entries to STALE; a real infinite loop still times out -->
          <timeoutFactor>3.0</timeoutFactor>
          <timeoutConstant>15000</timeoutConstant>
          <outputFormats><format>XML</format><format>HTML</format></outputFormats>
          
          
          <failWhenNoMutations>false</failWhenNoMutations>
          <!-- PIT appends surefire's argLine after these jvmArgs and the last -Xmx wins, so surefire's -Xmx2g replaced this heap: the GC log of run 42158184635 tops out at (2048M).
               The watchdog fires at 90% of the old gen, and the log shows a large live allocation climbing past that. -Xlog:gc lets the shard log confirm the heap.
               ExitOnOutOfMemoryError: a real OutOfMemoryError ends the minion, or a test would score it as a kill.
               -OmitStackTraceInFastThrow: once JIT-compiled, implicit exceptions lose their message; a test that reads one then fails with no mutant to blame (run 42158184635). -->
          <parseSurefireArgLine>false</parseSurefireArgLine>
          <jvmArgs><arg>-Xss16m</arg><arg>-Xmx3000m</arg><arg>-XX:ReservedCodeCacheSize=1g</arg><arg>-Xlog:gc,gc+init:stdout</arg><arg>-XX:+ExitOnOutOfMemoryError</arg><arg>-XX:-OmitStackTraceInFastThrow</arg></jvmArgs>
        </configuration></plugin>
    </plugins>
  </build>
</project>
