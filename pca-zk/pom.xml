<?xml version="1.0" encoding="UTF-8"?>
<!-- Kotlin face of the Java adapter net.atlasauth:pca-zk (Groth16 verification and proving of snarkjs artifacts over libpcazk through JNA). A separate module so
     the core library gains no native dependency. Install the Java core library and the adapter first (CI does: mvn install -DskipTests in java-pca and in
     pca-zk/adapter), then ATLAS_PCA_LIBPCAZK=/path/to/libpcazk.so ATLAS_PCA_LIBPCAZK_REQUIRED=1 mvn test -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.atlasauth</groupId><artifactId>pca-zk-kotlin</artifactId><version>0</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kotlin.version>2.0.21</kotlin.version>
  </properties>
  <dependencies>
    <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>${kotlin.version}</version></dependency>
    <!-- the Kotlin core verifier is compiled in from ../src (it is an Android library, so not a Maven dependency); it needs only BouncyCastle -->
    <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>1.80</version></dependency>
    <dependency><groupId>com.squareup.okhttp3</groupId><artifactId>okhttp</artifactId><version>4.12.0</version></dependency>
    <dependency><groupId>com.ibm.icu</groupId><artifactId>icu4j</artifactId><version>78.3</version></dependency>
    <dependency><groupId>net.atlasauth</groupId><artifactId>pca-zk</artifactId><version>0</version></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <sourceDirectory>src/main/kotlin</sourceDirectory>
    <testSourceDirectory>src/test/kotlin</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-maven-plugin</artifactId><version>${kotlin.version}</version>
        <configuration><jvmTarget>17</jvmTarget></configuration>
        <executions>
          <execution><id>compile</id><phase>compile</phase><goals><goal>compile</goal></goals>
            <configuration><sourceDirs><sourceDir>${project.basedir}/src/main/kotlin</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/analyzer</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/compliance</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/events</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/evidence</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/explain</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/gnap</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/intent</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/jose</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/payments</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/research</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/scitt</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/verifier</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/wallet</sourceDir><sourceDir>${project.basedir}/../src/main/kotlin/net/atlasauth/pca/webauthn</sourceDir>
              </sourceDirs></configuration></execution>
          <!-- the corpus replay is the core test's own (one dispatch for both engines) -->
          <execution><id>test-compile</id><phase>test-compile</phase><goals><goal>test-compile</goal></goals>
            <configuration><sourceDirs><sourceDir>${project.basedir}/src/test/kotlin</sourceDir><sourceDir>${project.basedir}/../src/mutation/kotlin/net/atlasauth/pca/verifier/zkreplay</sourceDir></sourceDirs></configuration></execution>
        </executions>
      </plugin>
      <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
    </plugins>
  </build>
</project>
